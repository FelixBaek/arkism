{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arkism",
  "version": "0.1.0",
  "identifier": "dev.arkism.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "create": false, "title": "Arkism", "width": 1440, "height": 900, "minWidth": 720, "minHeight": 560, "center": true, "decorations": false, "shadow": true, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://images.unsplash.com https://avatars.githubusercontent.com; style-src 'self'; font-src 'self' https://cdn.jsdelivr.net; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
