   "tags": [
    "basis:explicit_user",
    "event_id:claude_code:session_01JX8K2M2QWERTY"
   ],
   "created_by_type": "agent"
  },
  {
   "id": "m11",
   "text": "Orbit 이미지 업로드는 한 장에 10MB까지 받는다.",
