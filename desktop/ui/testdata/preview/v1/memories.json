   ],
   "created_by_type": "agent"
  },
  {
   "id": "m7",
   "text": "Orbit 테스트는 시간대를 UTC로 고정해야 날짜 비교가 깨지지 않는다.",
   "kind": "lesson",
   "status": "active",
   "revision": 1,
   "scope": {
