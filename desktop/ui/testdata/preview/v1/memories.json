   ],
   "created_by_type": "human"
  },
  {
   "id": "m-pin-select",
   "text": "선택 상태는 강조선 대신 글자 색으로 보여 준다.",
   "kind": "decision",
   "status": "active",
   "revision": 1,
   "scope": {
