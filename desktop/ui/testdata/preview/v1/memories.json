   ],
   "created_by_type": "agent"
  },
  {
   "id": "m4",
   "text": "Orbit 배포 전에는 스테이징에서 결제 흐름을 처음부터 끝까지 한 번 눌러 본다.",
   "kind": "lesson",
   "status": "active",
   "revision": 1,
   "scope": {
    "workspace_id": "default",
    "project_id": "default",
    "user_id": "management:owner"
