   "conflict_id": "r1"
  },
  {
   "id": "m5",
   "text": "Alex는 리뷰 코멘트를 파일별 목록으로 받는 걸 좋아한다.",
   "kind": "user",
   "status": "active",
   "revision": 1,
   "scope": {
