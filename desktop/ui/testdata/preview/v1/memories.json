   "approved_by": "management:owner",
   "tags": [
    "basis:explicit_user"
   ],
   "created_by_type": "human"
  },
  {
   "id": "m-pin-tokens",
   "text": "새 화면은 토큰에 있는 색만 쓰고, 임의의 hex 값을 넣지 않는다.",
   "kind": "procedural",
   "status": "active",
   "revision": 1,
   "scope": {
    "workspace_id": "default",
    "project_id": "default",
    "user_id": "management:owner"
   },
   "created_at": "2026-10-10T09:00:00Z",
