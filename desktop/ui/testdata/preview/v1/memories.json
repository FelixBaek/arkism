   ],
   "created_by_type": "agent"
  },
  {
   "id": "m10",
   "text": "Orbit 모바일 앱은 웹 뷰로 먼저 출시한다.",
   "kind": "decision",
   "status": "active",
   "revision": 1,
   "scope": {
    "workspace_id": "default",
    "project_id": "default",
    "user_id": "management:owner"
   },
   "created_at": "2026-10-04T13:16:34.299802Z",
