  },
  {
   "id": "m-pin-icons",
   "text": "화면 아이콘은 Phosphor 2.1 Regular로 통일한다.",
   "kind": "decision",
   "status": "active",
   "revision": 2,
   "scope": {
    "workspace_id": "default",
