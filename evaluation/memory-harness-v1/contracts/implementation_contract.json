{
  "contract_id": "arkism-offline-b0-v1",
  "status": "specification_ready",
  "execution_status": "execution_not_started",
  "is_product_contract": false,
  "format": "custom_typed_contract_not_json_schema",
  "notice": "사용자 요청에 따라 첫 개발 묶음의 인터페이스와 완료 기준을 확정한 명세다. 제품 구현·워커 실행·검수·제품 통합 완료를 뜻하지 않는다.",
  "target_repository": "/home/felix/110-arkism",
  "reference_commit": "27bb41807ff48d47559ba2cfc30feb300caacecf",
  "first_deliverable": "offline static B0 RRF + synthetic context packing + metric report; scalar decay independently tested and not used in baseline score",
  "schema_rules": {
    "all_declared_fields_required": true,
    "additional_fields": "reject",
    "duplicate_json_keys": "reject",
    "invalid_utf8_or_unpaired_surrogate": "reject",
    "automatic_unicode_normalization": "none",
    "automatic_trim_or_case_fold": "none",
    "int_lexical_form": "-?(0|[1-9][0-9]*)",
    "int64_min": 0,
    "int64_max_decimal": "9223372036854775807",
    "uint64_max_decimal": "18446744073709551615",
    "int_decode": "exact integer; never intermediate binary64",
    "float_decode": "finite IEEE754 binary64 using field type",
    "float_negative_zero": "normalize_to_positive_zero",
    "id_pattern": "^[a-z][a-z0-9_-]{0,63}$",
    "sha256_pattern": "^[0-9a-f]{64}$",
    "null_arrays": "reject; empty array must encode [] not null",
    "const_number_types": "const_int uses exact integer lexical form; const_float uses finite binary64"
  },
  "objects": {
    "Scope": {
      "fields": {
        "workspace": {
          "type": "id",
          "empty": "reject"
        },
        "project": {
          "type": "id",
          "empty": "reject"
        },
        "user": {
          "type": "id",
          "empty": "reject"
        },
        "agent": {
          "type": "id",
          "empty": "reject"
        }
      }
    },
    "Ref": {
      "fields": {
        "origin": {
