            "fixture_alt"
          ]
        },
        "collection": {
          "type": "enum",
          "values": [
            "memories"
          ]
        },
        "id": {
          "type": "id"
        },
        "revision": {
          "type": "int64",
          "min": 1
        },
        "content_sha256": {
          "type": "sha256"
        }
      }
    },
    "Candidate": {
      "fields": {
        "scope": {
          "type": "object",
          "object": "Scope"
        },
        "ref": {
          "type": "object",
          "object": "Ref"
        },
        "reasons": {
          "type": "array",
          "items_enum": [
            "exact_keyword",
            "text_search",
            "vector"
          ],
          "min_items": 0,
          "unique": true
        },
        "trust": {
          "type": "float64",
          "min": 0,
          "max": 1
        },
        "updated_at_ns": {
          "type": "int64",
          "min": 0
        },
        "observed_seq": {
          "type": "int64",
          "min": 1
        },
        "effective_at_ns": {
          "type": "int64",
          "min": 0
        },
        "context_cost_units": {
          "type": "int64",
          "min": 1,
          "max": 1000000
        },
        "approved": {
          "type": "bool"
        },
        "active": {
          "type": "bool"
        },
        "deleted": {
          "type": "bool"
        },
        "source_verified": {
          "type": "bool"
        },
        "authority": {
          "type": "const_string",
          "value": "data_only_untrusted"
        }
      },
      "semantic_rules": [
        "lane and ordinal come only from enclosing arrays",
        "flags are synthetic fixture fields, not product authorization results",
        "context_cost_units is not measured tokenizer cost"
      ]
    },
    "CandidateSnapshot": {
      "fields": {
        "snapshot_id": {
          "type": "id"
        },
        "stream_id": {
          "type": "id"
        },
        "scope": {
          "type": "object",
          "object": "Scope"
        },
        "as_of_ns": {
          "type": "int64",
          "min": 0
        },
        "as_of_seq": {
          "type": "int64",
          "min": 0
        },
        "lanes": {
          "type": "array_of_arrays",
          "items_object": "Candidate",
          "outer_items": 3
        }
      },
      "semantic_rules": [
        "lane order is exact, fts, vector; preserve empty arrays",
        "candidate scope must equal snapshot scope except explicit invalid-fixture tests",
        "candidate observed_seq <= as_of_seq and effective_at_ns <= as_of_ns",
        "same origin/collection/id with conflicting revision or hash is invalid",
        "metadata differences on the same valid Ref preserve first occurrence in RRF",
        "same RRF key across all occurrences requires identical scope, Ref, approved, active, deleted, source_verified, context_cost_units, observed_seq, effective_at_ns",
        "trust, updated_at_ns and reasons may differ; first occurrence metadata is preserved",
        "any scope/revision/hash/visibility/conflicting metadata violation rejects the entire input, not a per-query execution_error",
        "updated_at_ns <= as_of_ns",
        "eligibility false is valid data and excluded before fusion, retaining original lane ordinal"
      ]
    },
    "ContextBudget": {
      "fields": {
        "unit": {
          "type": "const_string",
          "value": "fixture_units_v0"
        },
        "limit": {
          "type": "int64",
          "min": 0,
          "max": 1000000
        }
      }
    },
    "Probe": {
      "fields": {
        "query_id": {
          "type": "id"
        },
        "stream_id": {
          "type": "id"
        },
        "scope": {
          "type": "object",
          "object": "Scope"
        },
        "at_ns": {
          "type": "int64",
          "min": 0
        },
        "cutoff_accepted_seq": {
          "type": "int64",
          "min": 0
        },
        "candidate_snapshot_id": {
          "type": "id"
        },
        "final_k": {
          "type": "int64",
          "min": 0,
          "max": 64
        },
        "context_budget": {
          "type": "object",
          "object": "ContextBudget"
        },
        "policy_id": {
          "type": "const_string",
          "value": "b0-rrf-synthetic-v1"
        }
      },
      "semantic_rules": [
        "snapshot stream_id, scope, as_of_ns, as_of_seq must equal probe fields",
        "no gold, split, category, event, query text, or reinforcement field",
        "all probes in this baseline are independent reads of supplied immutable snapshots"
      ]
    },
    "Gold": {
      "fields": {
        "query_id": {
          "type": "id"
        },
        "stream_id": {
          "type": "id"
        },
        "scope": {
          "type": "object",
          "object": "Scope"
        },
        "at_ns": {
          "type": "int64",
          "min": 0
