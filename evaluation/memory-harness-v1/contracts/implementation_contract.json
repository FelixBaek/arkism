        },
        "label_status": {
          "type": "enum",
          "values": [
            "relevant",
            "clear_negative",
            "ambiguous"
          ]
        },
        "relevant_refs": {
          "type": "array",
          "items_object": "Ref",
          "min_items": 0,
          "unique": true
        }
      },
      "semantic_rules": [
        "relevant requires one or more relevant_refs",
        "clear_negative and ambiguous require empty relevant_refs",
        "ambiguous is excluded from relevance and negative primary denominators",
        "gold stream/scope/time/cutoff must match scheduled probe",
        "historical means versioned synthetic evidence exists; never infer unavailable product body"
      ]
    },
    "Prediction": {
      "fields": {
        "query_id": {
          "type": "id"
        },
        "stream_id": {
          "type": "id"
        },
        "scope": {
          "type": "object",
          "object": "Scope"
        },
        "status": {
          "type": "enum",
          "values": [
            "success",
            "timeout",
            "error"
          ]
        },
        "selected_refs": {
          "type": "array",
          "items_object": "Ref",
          "min_items": 0
        },
        "error_code": {
          "type": "enum",
          "values": [
            "none",
            "timeout",
            "execution_error"
          ]
        }
      },
      "semantic_rules": [
        "success requires error_code=none",
        "timeout requires error_code=timeout",
        "error requires error_code=execution_error",
        "timeout/error partial selected_refs are ignored by primary recall",
        "each scheduled probe requires exactly one row; absent rows are missing-output errors",
        "successful raw selected_refs length above final_k is a run format error",
        "successful duplicate refs within k are deduplicated for metrics"
      ]
    },
    "Policy": {
      "fields": {
        "contract_id": {
          "type": "const_string",
          "value": "arkism-offline-b0-v1"
        },
