{
  "dynamics_contract_sha256": "952d663b76254e15a3a65ab09dcd580504bc4c2814ce4903a8883ece1ca8f0da",
  "feature_rules": [
    "present⇒valueunitnonnull/missing_reasonnull; missing⇒valuenull/fixedmissingreason",
    "samefullscope/target/sourceCAS/hash; observedknown<=probeat,sameclock; availableat<=probeat/seq<=cutoff",
    "featurefuture/backfill/gold/split/posthoc/trustrename forbidden; independent rules/version/provenance mandatory"
  ],
  "hash_reference_domains": {
    "CLIStatus.outputs completion_manifest raw_sha256": {
      "referent": "actual published manifest.json rawbytesSHA",
      "self_reference": "not inside OutputManifest.files"
    },
    "EvidenceBinding.task_sha256": {
      "metadata_equality": "TaskBinding.task_sha256 and task_ref.content_sha256",
      "referent": "exact original task-definition raw artifact SHA"
    },
    "EvidenceConsumption.claim_sha256": {
      "projection": "EvidenceClaimProjectionV2",
      "registration": "only firstqualifiedknownoutcome; unknown/unattributable/unqualified/exposure never creates entry"
    },
    "EvidenceConsumption.first_receipt_sha256": {
      "immutable": true,
      "referent": "최초적격consumptionReceipt의ReceiptV2.receipt_sha256"
    },
    "EvidenceConsumption.identity_sha256": {
      "does_not_depend_on": [
        "ReceiptV2",
        "EvidenceConsumption.first_receipt_sha256",
        "duplicate_of_receipt_sha256",
        "claim_sha256"
      ],
      "projection": "EvidenceIdentityProjectionV2"
    },
    "EvidenceRef.content_sha256_for_task_ref": {
      "referent": "exact original task-definition artifact rawbytesSHA; sourceevidencehash와구별"
    },
    "OutputManifest.run_config_raw_sha256": {
      "not": "typed config hash",
      "referent": "SHA256(actual --config argvfile exactrawbytes)"
    },
    "OutputManifest.run_config_sha256": {
      "not": "argvrawfilehash",
      "referent": "DynamicsRunConfigV2.config_sha256 typed full config semantic hash"
    },
    "OutputRoleFile.raw_sha256": {
      "path_domain": "trusted outroot-relative fixed output path",
      "referent": "SHA256(actual relative_path artifact exactrawbytes)"
    },
    "RankerConfigV2.inherited_b2_config_sha256": {
      "binding": "That B2 ranker parameter digest already includes original B2 dynamics_config_sha256; never use full PolicyConfig or registry-associated full-wire hash.",
      "consumption": "Ablation disables only numeric decay or jumps. A qualified known outcome still has the same evidence-consumption eligibility when NOOUT/eta=0 gives a zero jump; no qualification, binding or history guard is removed.",
      "context": "PolicyRegistryV2/DynamicsRunConfigV2 validation must locate actual selected B2 entry and compare both complete configurations.",
      "dynamics_allowed_difference": [
        "exactly selected decay_enabled or outcome_jump_enabled switch",
        "own config_sha256"
      ],
      "ranker_allowed_difference": [
        "policy_id",
        "policy_version",
        "dynamics_config_sha256",
        "inherited_b2_config_sha256",
        "ablation",
        "config_sha256",
        "registry_sha256 association"
      ],
      "required_unchanged": "All other fields, including lane definitions/weights, offset, feature/missing/fallback rules, tolerances and evidence rules, must match selected B2.",
      "target": "selected B2 RankerConfigV2.config_sha256, the fixed RankerParametersProjection digest"
    },
    "ReceiptV2.duplicate_of_receipt_sha256": {
      "nonnull_when": "NEW-IDsamequalifiedconsumedidentity+sameclaim",
      "null_otherwise": true,
      "referent": "동일consumedidentity의EvidenceConsumption.first_receipt_sha256"
    },
    "ReceiptV2.evidence_consumption_sha256": {
      "exactretry": "reuseoriginalreceiptfieldunchanged",
      "kind": "identityprojectionSHA, NOT full EvidenceConsumptionrecordSHA",
      "nonnull_when": [
        "firstqualifiedconsumptionreceipt",
        "NEW-IDduplicateofpreviousqualifiedconsumption"
      ],
      "null_when": [
        "unknown",
        "failed_unattributable",
        "unqualifiedoutcome",
        "exposure",
        "activate",
        "invalidation"
      ],
      "referent": "EvidenceConsumption.identity_sha256"
    },
    "TaskBinding.task_sha256": {
      "algorithm": "SHA256 exact original task-definition artifact rawbytes",
      "equal_to": [
        "TaskBinding.task_ref.content_sha256",
        "EvidenceBinding.task_sha256"
      ],
      "not": [
        "TaskBindingselfhash",
        "relationshipgraphhash",
        "nativeDTOcanonicalselfhash"
      ],
      "rawbody_verifier": "fixtureparent 별도검증; EventDTObody미휴대"
    }
  },
